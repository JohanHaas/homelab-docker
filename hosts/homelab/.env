# Images
NEXTCLOUD_IMAGE=ghcr.io/nextcloud-releases/all-in-one:20260825_084538

# Nextcloud AIO
# Ablageort der Nutzerdaten auf dem Host (wird vom Mastercontainer an den
# nextcloud-Container weitergegeben, muss beim Erst-Setup leer sein).
NEXTCLOUD_DATADIR=/storage/cloud

# Reverse Proxy: Caddy auf dem Gateway (nix-vps, 100.64.0.2) terminiert TLS
# und proxyt ueber das Tailnet auf diesen Port.
APACHE_PORT=11000
APACHE_IP_BINDING=0.0.0.0
NEXTCLOUD_TRUSTED_PROXIES=100.64.0.2

# GitHub Runner (Token und Repo-URL kommen von systemd)
RUNNER_LABELS=homelab,self-hosted
