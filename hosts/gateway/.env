# Images
CADDY_IMAGE=caddy:2.8.4
HEADSCALE_IMAGE=docker.io/headscale/headscale:0.29.3

# Caddy
CADDY_CONF=${PWD}/caddy/conf
CADDY_DATA=caddy_data
CADDY_CONFIG=caddy_config

# Headscale
# Config kommt aus dem Repo (read-only), State liegt bewusst NICHT im
# Working Tree, sonst haengt die DB am Deploy-Checkout.
HEADSCALE_CONFIG=${PWD}/headscale/config
HEADSCALE_LIB=headscale_lib

# Network
PROXY_SUBNET=172.28.0.0/16

# GitHub Runner (Token und Repo-URL kommen von systemd)
RUNNER_LABELS=gateway,self-hosted
